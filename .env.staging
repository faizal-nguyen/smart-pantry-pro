# Staging Environment
# Generated on 2025-10-03

VITE_ENV=staging

# Supabase Configuration (REQUIRED)
# TODO: Create separate Supabase project for staging
VITE_SUPABASE_URL=https://your-staging-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-staging-anon-key-here

# OpenAI API (OPTIONAL - for AI features)
# TODO: Use separate OpenAI key for staging with budget limits
VITE_OPENAI_API_KEY=sk-staging-key-here

# Deepgram API (OPTIONAL - for voice features)
VITE_DEEPGRAM_API_KEY=staging-deepgram-key-here

# Cloudinary (OPTIONAL - for image upload)
# TODO: Use separate Cloudinary account or folder for staging
VITE_CLOUDINARY_CLOUD_NAME=your-staging-cloudinary
VITE_CLOUDINARY_API_KEY=your-staging-cloudinary-key

# Feature Flags
NEXT_PUBLIC_CONTEXTUAL_SYSTEM_ENABLED=true
CONTEXTUAL_CACHE_TTL=3600
