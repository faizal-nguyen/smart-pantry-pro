{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/((?!assets/).*)",
      "destination": "/index.html"
    }
  ],
  "buildCommand": "npm run shared:build && npm run api:build:ts && npm run build:optimized",
  "outputDirectory": "dist",
  "installCommand": "npm install --legacy-peer-deps --force",
  "framework": "vite",
  "regions": [
    "fra1"
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "apps/api/config/assistant-model-approval.json"
    }
  },
  "build": {
    "env": {
      "NODE_ENV": "production",
      "VITE_BUILD_OPTIMIZE": "true"
    }
  }
}
