{
  "functions": {
    "api-functions/*.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api-functions/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "buildCommand": "npm run build:optimized",
  "outputDirectory": "dist",
  "installCommand": "npm install --legacy-peer-deps --force",
  "framework": "vite",
  "build": {
    "env": {
      "NODE_ENV": "production",
      "VITE_BUILD_OPTIMIZE": "true"
    }
  }
}