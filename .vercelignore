# Ignorer les fichiers de développement
node_modules
.git
.env.local
.env.development.local
.env.test.local
.env.production.local

# Ignorer les dossiers non-frontend
# NB: leading `/` ancre au root — sans ça, `supabase/` matche aussi
# `src/integrations/supabase/` et `services/` matche `src/services/`,
# ce qui casse le build Vite (client supabase + services manquants).
.claude/
/apps/
/agents/
/services/
/PRP/
/supabase/

# Ignorer les fichiers de cache
.cache
.parcel-cache
.vite
.vite-build-cache

# Ignorer les fichiers de test
coverage
*.test.js
*.test.ts
*.spec.js
*.spec.ts
__tests__
test
tests

# Ignorer les fichiers de documentation
README.md
docs/
*.md
BARCODE_API.md
DEPLOYMENT.md

# Ignorer les fichiers de développement
# NB: on utilise `scripts/*` (glob) et pas `scripts/` (dir) — gitignore
# ne sait pas ré-inclure un fichier d'un dossier déjà exclu. Avec le
# glob, la négation `!scripts/prepare-husky.cjs` fonctionne.
scripts/*
# … sauf ceux référencés par les lifecycle scripts (npm prepare /
# postinstall). Sans cette exception, Vercel exclut le script et
# `npm install` plante avec MODULE_NOT_FOUND.
!scripts/prepare-husky.cjs
.vscode/
.idea/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Ignorer les fichiers temporaires
.tmp
.temp
*.tmp
*.temp

# Ignorer les fichiers de build locaux
dist/
build/
out/

# Ignorer les fichiers de configuration de développement
.eslintrc.js
.prettierrc
.editorconfig 