{
  "version": 2,
  "name": "smart-pantry-dev",
  "env": {
    "VITE_ENV": "development"
  },
  "build": {
    "env": {
      "VITE_ENV": "development"
    }
  },
  "buildCommand": "npm run build:dev",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
