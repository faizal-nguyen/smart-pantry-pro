# Production Environment
# Generated on 2025-10-03
# ⚠️ WARNING: Use production-grade secrets only!

VITE_ENV=production

# Supabase Configuration (REQUIRED)
# TODO: Create separate Supabase project for production with proper RLS
VITE_SUPABASE_URL=https://your-production-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-production-anon-key-here

# OpenAI API (OPTIONAL - for AI features)
# TODO: Use production OpenAI key with proper rate limits and monitoring
VITE_OPENAI_API_KEY=sk-production-key-here

# Deepgram API (OPTIONAL - for voice features)
VITE_DEEPGRAM_API_KEY=production-deepgram-key-here

# Cloudinary (OPTIONAL - for image upload)
# TODO: Use production Cloudinary account with CDN configured
VITE_CLOUDINARY_CLOUD_NAME=your-production-cloudinary
VITE_CLOUDINARY_API_KEY=your-production-cloudinary-key

# Feature Flags
NEXT_PUBLIC_CONTEXTUAL_SYSTEM_ENABLED=true
CONTEXTUAL_CACHE_TTL=7200
