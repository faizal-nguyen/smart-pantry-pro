# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
# Environment files - NEVER commit these
.env
.env.local
.env.*.local
.env.development
.env.development.local
.env.staging
.env.staging.local
.env.production
.env.production.local
apps/**/.env
services/**/.env
**/secrets/
**/*.pem
**/*.key

# Keep template environment files only
!.env.example
!apps/**/.env.example
!services/**/.env.example

# MCP Configuration (contains sensitive tokens)
.mcp/config.json
.cursorrules
.vercel
# Python build artefacts — services/video-processor/ uses a local venv that
# must never be committed (libtorch_cpu.dylib alone is ~215MB). The wrong
# path `api/video-processor/venv/` was previously listed here; it never
# matched the real layout (`services/video-processor/`).
services/video-processor/venv/
services/video-processor/.venv/
services/video-processor/__pycache__/
**/__pycache__/
*.pyc

# Playwright (PRP-220.21)
/playwright-report/
/test-results/
/blob-report/
/playwright/.cache/

# macOS iCloud / Finder duplicates — files named "foo 2.ext" or dirs "foo 2/"
*\ 2.*
*\ 2/
*\ 2

# Local media drops (videos for recipe extraction, etc.) — not for the repo
videos/

# Supabase CLI cache
supabase/.temp/
