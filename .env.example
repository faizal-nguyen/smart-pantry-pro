# =====================================================================
# Smart Pantry Pro - .env template (CLIENT)
# =====================================================================
# Copy this file to .env.local for local development.
# Never commit .env.local, .env.development, .env.staging or .env.production.
#
# Anything prefixed with VITE_ is bundled into the client and PUBLIC.
# Server-only secrets belong in apps/api/.env (cf apps/api/.env.example).
#
# Reference: PRP-220.01 (rotation des secrets)
# =====================================================================

# Environment (development | staging | production)
VITE_ENV=development

# --- Supabase (PUBLIC) ---
# anon key is intended to be public + protected by RLS.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- API base URL ---
# In dev, Vite proxies /api -> http://localhost:4000.
# Set this only if you want to call a remote API directly.
VITE_API_BASE_URL=

# --- Cloudinary (PUBLIC ONLY) ---
# cloud_name and api_key are public; api_secret is SERVER-ONLY (cf apps/api/.env).
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_API_KEY=

# --- Feature flags ---
VITE_ENABLE_SOCIAL_IMPORT=true
VITE_ENABLE_VOICE_RECOGNITION=true
VITE_ENABLE_VISION_API=true
VITE_ENABLE_FAMILY_SYNC=true
VITE_ENABLE_OFFLINE_MODE=true

# --- Contextual system (public toggles only) ---
NEXT_PUBLIC_CONTEXTUAL_SYSTEM_ENABLED=true
VIDEO_WORKER_SHARED_SECRET=

# =====================================================================
# DO NOT add secrets below. The following keys MUST live in apps/api/.env
# (server only) and never reach the client bundle:
#
#   - OPENAI_API_KEY
#   - DEEPGRAM_API_KEY
#   - CLOUDINARY_API_SECRET
#   - YOUTUBE_API_KEY
#   - SUPABASE_SERVICE_KEY / SUPABASE_SERVICE_ROLE_KEY
#   - FACEBOOK_APP_SECRET
#   - JWT_SECRET, ENCRYPTION_KEY
#
# Any VITE_OPENAI_API_KEY / VITE_DEEPGRAM_API_KEY / VITE_*_SECRET is
# considered a leak. See PRP-220.02 for the migration plan.
# =====================================================================
