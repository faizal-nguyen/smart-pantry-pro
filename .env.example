# Smart Pantry Pro - Environment Variables Template
# Copy this file to .env.local and fill in your values
# Or use .env.development, .env.staging, .env.production for specific environments

# Environment (development | staging | production)
VITE_ENV=development

# Supabase Configuration (REQUIRED)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# OpenAI API (OPTIONAL - for AI features)
OPENAI_API_KEY=sk-your-openai-key
VITE_OPENAI_API_KEY=sk-your-openai-key

# OpenFoodFacts Configuration (optional)
OPENFOODFACTS_API_KEY=your_openfoodfacts_key_here
OPENFOODFACTS_USER_AGENT=SmartPantryPro/1.0

# Vision API Configuration (optional)
CLARIFAI_API_KEY=your_clarifai_api_key_here
GOOGLE_VISION_API_KEY=your_google_vision_key_here

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes
RATE_LIMIT_MAX_REQUESTS=50

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Image Proxy Allowlist (comma-separated hostnames)
IMAGE_PROXY_HOSTS=instagram.com,cdninstagram.com,scontent.cdninstagram.com

# External Video Processor (optional)
# If set, API will forward video endpoints to this service
VIDEO_PROCESSOR_URL=

# Security Configuration
JWT_SECRET=your_jwt_secret_here
ENCRYPTION_KEY=your_encryption_key_here

# Production URLs (when deployed)
# PRODUCTION_URL=https://smartpantrypro.com
# API_URL=https://api.smartpantrypro.com

# Monitoring (optional)
# SENTRY_DSN=your_sentry_dsn_here
# LOGROCKET_APP_ID=your_logrocket_id_here

# Feature Flags
ENABLE_VOICE_RECOGNITION=true
ENABLE_VISION_API=true
ENABLE_FAMILY_SYNC=true
ENABLE_OFFLINE_MODE=true

# Système Contextuel - APIs Météo
NEXT_PUBLIC_OPENWEATHER_API_KEY=your_openweather_api_key_here
NEXT_PUBLIC_WEATHERAPI_KEY=your_weatherapi_backup_key_here

# Système Contextuel - APIs Calendrier
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
NEXT_PUBLIC_GOOGLE_CLIENT_SECRET=your_google_oauth_secret_here

# Système Contextuel - Configuration
NEXT_PUBLIC_CONTEXTUAL_SYSTEM_ENABLED=true
CONTEXTUAL_CACHE_TTL=3600 # Cache timeout en secondes (1 heure)
CONTEXTUAL_MAX_ADAPTATIONS=5 # Nombre max d'adaptations par semaine

# Social Media Parser V2 Enhanced Configuration
FACEBOOK_ACCESS_TOKEN=your_facebook_access_token_for_instagram_oembed
FACEBOOK_APP_ID=your_facebook_app_id_here
FACEBOOK_APP_SECRET=your_facebook_app_secret_here
ENABLE_ENHANCED_SOCIAL_PARSER=true
SOCIAL_PARSER_CACHE_TTL=3600 # Cache timeout in seconds (1 hour)
SOCIAL_PARSER_MAX_CACHE_SIZE=100 # Maximum cached entries

# Social Media Platform API Keys (optional)
# INSTAGRAM_BASIC_DISPLAY_API_TOKEN=your_instagram_basic_display_token
# YOUTUBE_DATA_API_KEY=your_youtube_api_key
# TIKTOK_API_KEY=your_tiktok_api_key

# Fast Video Parser Configuration (NEW)
DEEPGRAM_API_KEY=your_deepgram_api_key_here
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
ENABLE_FAST_VIDEO_PARSER=true
VIDEO_PARSER_MAX_DURATION=300 # Max video duration in seconds (5 min)
VIDEO_PARSER_TIMEOUT=45000 # Timeout in ms (45 seconds)
