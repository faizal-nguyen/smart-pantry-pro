# =====================================================================
# Smart Pantry API - .env template (SERVER)
# =====================================================================
# Copy this file to apps/api/.env. Never commit apps/api/.env.
# All values below are SERVER-ONLY. They MUST NOT appear in any
# VITE_* variable or in the client bundle.
#
# Reference: PRP-220.01 (rotation des secrets)
# =====================================================================

# ----- Server -----
PORT=4000
NODE_ENV=development
LOG_LEVEL=info
LOG_PRETTY_PRINT=true

# ----- CORS -----
# Comma-separated list of allowed origins.
ALLOWED_ORIGINS=http://localhost:3002,http://localhost:5173

# ----- Supabase -----
# URL and anon key are also used client-side; service key is SECRET.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_KEY=your_service_role_key   # SECRET - server only, never in any VITE_*

# ----- AI providers (SECRET) -----
OPENAI_API_KEY=sk-your-openai-key
DEEPGRAM_API_KEY=your_deepgram_api_key

# ----- Media (Cloudinary) -----
# cloud_name and api_key are public (also exposed to client),
# api_secret is SECRET.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=                       # SECRET

# ----- YouTube Data API -----
YOUTUBE_API_KEY=                              # SECRET

# ----- Instagram / Facebook (oEmbed, optional) -----
# INSTAGRAM_OEMBED_TOKEN=
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=                        # SECRET

# ----- Rate limiting -----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_YT_WINDOW_MS=60000
RATE_LIMIT_YT_MAX=30
RATE_LIMIT_AI_WINDOW_MS=60000
RATE_LIMIT_AI_MAX=30

# ----- Per-user rate limiting + observability (PRP-220.15) -----
# When set, the userRateLimit middleware uses Redis as a shared store so
# limits are honored across replicas. Falls back to in-memory otherwise
# (single-instance deploys only).
# REDIS_URL=redis://localhost:6379

# Bearer token guarding GET /api/metrics in production. Leave unset in
# dev to keep the endpoint open behind localhost.
# METRICS_AUTH_TOKEN=

# ----- Database -----
DB_POOL_SIZE=10
DB_QUERY_TIMEOUT=30000

# ----- External services -----
# VIDEO_PROCESSOR_URL=http://localhost:8081

# ----- Security -----
FORCE_HTTPS=false
# JWT_SECRET=                                  # SECRET (only if used beyond Supabase JWT)
# ENCRYPTION_KEY=                              # SECRET
