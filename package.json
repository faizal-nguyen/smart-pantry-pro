{
  "name": "vite_react_shadcn_ts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm:api:dev\" \"npm:web:dev\"",
    "predev": "npm run shared:build",
    "web:dev": "vite --port 3002",
    "api:dev": "npm run api:build:ts && node apps/api/dist/index.js",
    "dev:vite": "vite",
    "api": "npm run api:dev",
    "dev:full": "concurrently \"npm run api:dev\" \"npm run dev:vite\"",
    "start": "./start-dev.sh",
    "shared:build": "tsc -p packages/shared/tsconfig.json",
    "build": "npm run shared:build && npm run api:build:ts && vite build",
    "build:dev": "vite build --mode development",
    "build:staging": "vite build --mode staging",
    "build:production": "vite build --mode production",
    "build:vercel": "./vercel-build.sh",
    "build:optimized": "NODE_ENV=production VITE_BUILD_OPTIMIZE=true vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "deploy": "./scripts/deploy.sh",
    "analyze": "vite build --mode analyze",
    "debug:analyze": "node debug-dispatcher.js analyze",
    "debug:quick": "node debug-dispatcher.js quick",
    "debug:frontend": "node debug-dispatcher.js analyze",
    "debug:backend": "node debug-dispatcher.js analyze",
    "debug:database": "node debug-dispatcher.js analyze",
    "debug:performance": "node debug-dispatcher.js analyze",
    "debug:game-logic": "node debug-dispatcher.js analyze",
    "security:check": "node scripts/security-baseline-check.cjs",
    "security:secrets": "node scripts/security-baseline-check.cjs --secrets-only",
    "security:secrets:staged": "node scripts/security-baseline-check.cjs --staged-only",
    "security:env": "node -e \"console.log('Deprecated: security:env (legacy). Environment validation now lives in apps/api (see apps/api/src/config/env.ts).')\"",
    "prepare": "husky",
    "security:audit": "npm audit --production",
    "security:all": "npm run security:env && npm run security:check && npm run security:audit",
    "debug:integration": "node debug-dispatcher.js analyze",
    "debug:voice": "node smart-pantry-agents.js voice",
    "debug:scanner": "node smart-pantry-agents.js scanner",
    "debug:smart-pantry": "node smart-pantry-agents.js analyze",
    "debug:voice-ai": "node smart-pantry-agents.js voice",
    "debug:inventory-camera": "node smart-pantry-agents.js scanner",
    "claude:voice": "node claude-runner.js /debug-voice",
    "claude:scanner": "node claude-runner.js /debug-scanner",
    "claude:smart-pantry": "node claude-runner.js /debug-smart-pantry",
    "claude:voice-ai": "node claude-runner.js /debug-voice-ai",
    "claude:inventory-camera": "node claude-runner.js /debug-inventory-camera",
    "agents:init": "node integrate-agents.js init",
    "agents:status": "node integrate-agents.js status",
    "agents:test": "node integrate-agents.js test",
    "agents:debug": "node integrate-agents.js debug",
    "agents:optimize": "node integrate-agents.js optimize",
    "mcp:supabase": "npx -y @supabase/mcp-server-supabase@latest --project-ref=jwoxacnflphclslpqfzs",
    "mcp:test": "echo 'Testing Supabase MCP connection...' && npm run mcp:supabase -- --help",
    "test": "jest",
    "test:api": "jest -c apps/api/jest.config.cjs --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:evolution": "jest src/services/__tests__/evolutionV2-validation.test.ts",
    "test:prp220": "jest --testPathPattern '(recipe-import|RecipeSourceCard|InboxQuotaBadge|BulkImportButton|isRecipeLikely|useClipboardImportSuggestion|featureGates|inbox)' --no-coverage",
    "test:full": "npm run test:prp220 && npm run test:api -- --testPathPattern '(SocialImport|RecipeExtractionService|PlatformAdapters|userRateLimit|saveImportedDraftAsRecipe|canonicalUrl|cursor|sourceHash)'",
    "test:video-import": "node test-fast-video-import.js",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:update-snapshots": "playwright test --update-snapshots",
    "api:build:ts": "tsc -p apps/api/tsconfig.json",
    "api:start:ts": "node apps/api/dist/index.js",
    "postinstall": "npm run shared:build || true"
  },
