{
  "name": "vite_react_shadcn_ts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm:api:dev\" \"npm:web:dev\"",
    "predev": "npm run shared:build",
    "web:dev": "vite --port 3002",
    "api:dev": "npm run api:build:ts && node apps/api/dist/index.js",
    "dev:vite": "vite",
    "api": "npm run api:dev",
    "dev:full": "concurrently \"npm run api:dev\" \"npm run dev:vite\"",
    "start": "./start-dev.sh",
    "shared:build": "tsc -p packages/shared/tsconfig.json",
    "build": "npm run shared:build && npm run api:build:ts && vite build",
    "build:dev": "vite build --mode development",
    "build:staging": "vite build --mode staging",
    "build:production": "vite build --mode production",
    "build:optimized": "NODE_ENV=production VITE_BUILD_OPTIMIZE=true vite build",
    "lint": "eslint .",
    "lint:ci": "eslint . --pass-on-unpruned-suppressions",
    "typecheck:app": "node scripts/tsc-baseline.mjs",
    "typecheck:app:update": "node scripts/tsc-baseline.mjs --update",
    "preview": "vite preview",
    "deploy": "./scripts/deploy.sh",
    "analyze": "vite build --mode analyze",
    "security:check": "node scripts/security-baseline-check.cjs",
    "security:secrets": "node scripts/security-baseline-check.cjs --secrets-only",
    "security:secrets:staged": "node scripts/security-baseline-check.cjs --staged-only",
    "security:env": "node -e \"console.log('Deprecated: security:env (legacy). Environment validation now lives in apps/api (see apps/api/src/config/env.ts).')\"",
    "prepare": "node scripts/prepare-husky.cjs",
    "security:audit": "npm audit --production",
    "security:all": "npm run security:env && npm run security:check && npm run security:audit",
    "mcp:supabase": "npx -y @supabase/mcp-server-supabase@latest --project-ref=jwoxacnflphclslpqfzs",
    "mcp:test": "echo 'Testing Supabase MCP connection...' && npm run mcp:supabase -- --help",
    "test": "jest",
    "test:api": "jest -c apps/api/jest.config.cjs --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:evolution": "jest src/services/__tests__/evolutionV2-validation.test.ts",
    "test:prp220": "jest --testPathPattern '(recipe-import|RecipeSourceCard|InboxQuotaBadge|BulkImportButton|isRecipeLikely|useClipboardImportSuggestion|featureGates|inbox)' --no-coverage",
    "test:full": "npm run test:prp220 && npm run test:api -- --testPathPattern '(SocialImport|RecipeExtractionService|PlatformAdapters|userRateLimit|saveImportedDraftAsRecipe|canonicalUrl|cursor|sourceHash)'",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:update-snapshots": "playwright test --update-snapshots",
    "api:build:ts": "tsc -p apps/api/tsconfig.json",
    "api:start:ts": "node apps/api/dist/index.js",
    "backfill:product-embeddings": "tsx scripts/backfill-product-embeddings.ts",
    "dedup:product-catalog": "tsx scripts/dedup-product-catalog.ts",
    "dedup:plurals": "tsx scripts/dedup-product-plurals.ts",
    "backfill:recipe-ingredient-fk": "tsx scripts/backfill-recipe-ingredient-fk.ts",
    "backfill:recipe-ingredient-canonical": "tsx scripts/backfill-recipe-ingredient-canonical.ts",
    "backfill:recipe-facets": "tsx scripts/backfill-recipe-facets.ts",
    "assistant:qa": "tsx scripts/run-assistant-qa.ts",
    "recipe:policy:audit": "tsx scripts/audit-recipe-policy.ts",
    "recipe:policy:check": "tsx scripts/audit-recipe-policy.ts --seeds supabase/seeds --check",
    "postinstall": "npm run shared:build || true",
    "test:v10:client": "jest --runInBand --testPathPattern \"\\.v10\\.test\" --no-coverage",
    "test:v10:api": "jest -c apps/api/jest.unit.config.cjs --runInBand --testPathPattern \"ai/__tests__|recommendations/__tests__|handlers/__tests__/(read|write|internal|memory).test|services/stock/__tests__|services/privacy/__tests__|VoiceAgentService|GroceryPhotoRecognizer|RiskClassifier|CookingJournal|SocialVideoImportQueue|routes/__tests__/(stock|nutrition-profile|recommendations|assistant.memory|assistant.models|assistant.transcribe|assistant.photos|settings.privacy).routes|SpeechTranscriber|Memory.*test|ContextBuilder|ConversationSummary.*test|src/__tests__/(app.cold-start|cors).test\" --no-coverage",
    "test:v10": "npm run shared:build && npm run test:v10:client && npm run test:v10:api",
    "test:v10:db": "python3 scripts/test-v10-stock-db.py",
    "test:v10:03:db": "python3 scripts/test-v10-personalization-db.py",
    "test:v10:03c:db": "python3 scripts/test-v10-memory-db.py",
    "test:v10:pantry:db": "python3 scripts/test-v10-pantry-db.py",
    "test:deletion:db": "python3 scripts/test-deletion-requests-db.py",
    "test:recipe-images:db": "python3 scripts/test-recipe-images-bucket-db.py",
    "test:grocery-photos:db": "python3 scripts/test-grocery-photos-db.py",
    "test:security:db": "python3 scripts/test-security-baseline-db.py",
    "test:security:ownership:db": "python3 scripts/test-security-ownership-db.py",
    "test:stock:units:db": "python3 scripts/test-stock-units-db.py",
    "test:menu:shopping:db": "python3 scripts/test-menu-shopping-db.py",
    "test:assistant:memory:db": "python3 scripts/test-assistant-memory-thread-db.py",
    "audit:v10:memory": "node --import tsx scripts/audit-v10-memory.ts",
    "test:v10:ui": "vite --config scripts/vite-v10-fixture.config.ts",
    "benchmark:v10:models": "node --import tsx scripts/benchmark-v10-models.ts",
    "test:v10:03f:api": "jest -c apps/api/jest.unit.config.cjs --runInBand --testPathPattern \"Discovery|discovery|SocialImport|RecipeExtractionService|PlatformAdapters|saveImportedDraftAsRecipe|canonicalUrl|sourceHash|ThumbnailSnapshot|imports.wiring\" --no-coverage",
    "test:v10:03f:client": "jest --runInBand --testPathPattern \"discovery.*v10.test|draft-form.v10.test|recipes-discovery.v10.test|recipes-import-canonical.v10.test\" --no-coverage",
    "test:v10:03f:db": "python3 scripts/test-v10-discovery-db.py"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
