#!/usr/bin/env bash
set -euo pipefail

# Start the dev server on port 3030
PORT=3030

# Project root: two levels up from this script (/.claude/commands)
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")"/../..; pwd)"
cd "$ROOT_DIR/smart-pantry-pro"

echo "Starting Smart Grocery dev server on port $PORT from $ROOT_DIR/smart-pantry-pro"

# Build shared packages first
echo "Building shared packages..."
npm run shared:build

# Start both API and web dev servers
echo "Starting API and web servers..."
PORT=$PORT npm run dev
