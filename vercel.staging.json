{
  "version": 2,
  "name": "smart-pantry-staging",
  "env": {
    "VITE_ENV": "staging"
  },
  "build": {
    "env": {
      "VITE_ENV": "staging"
    }
  },
  "buildCommand": "npm run build:staging",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
